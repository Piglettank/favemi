<Window x:Class="Favemi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="favemi"
        Width="1100" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#1C1C1C" Foreground="#F2F2F2"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111111">
            <Image x:Name="Viewer" Stretch="Uniform" />
            <TextBlock x:Name="Placeholder"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="#8A8A8A" FontSize="16"
                       Text="Open a folder to look through its images" />
        </Grid>

        <DockPanel Grid.Row="1" Margin="16,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Open folder" Click="OnOpenFolder" ToolTip="Open folder  Ctrl+O" />
                <Button x:Name="PreviousButton" Content="Previous" Click="OnPrevious" IsEnabled="False" />
                <Button x:Name="FavoriteButton" Content="Favorite" Click="OnFavorite" IsEnabled="False" />
                <Button x:Name="NextButton" Content="Next" Click="OnNext" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="Status"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                       Foreground="#B0B0B0" />
        </DockPanel>
    </Grid>
</Window>
